{
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/legacy_react_native/**",
    "**/.dart_tool/**",
    "**/build/**"
  ],
  "search.exclude": {
    "**/node_modules": true,
    "**/legacy_react_native": true,
    "**/.dart_tool": true,
    "**/build": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/legacy_react_native/**": true,
    "**/.dart_tool/**": true,
    "**/build/**": true
  }
}
